# Twitch app credentials (server-side only; never put these in public/index.html)
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
PORT=3000

# Optional official moderator sync. Use a USER access token authorized for the relevant channels.
# Required scope: moderation:read for broadcaster-owned channels, or moderator:read:moderators
# for channels where the authorized account is a moderator (depending on Twitch authorization).
# Keep this token private; never commit a real token.
TWITCH_USER_ACCESS_TOKEN=
# Comma-separated Twitch channel logins to query, e.g. mob_nadziratel,z3kat,cherrys_fox
TWITCH_MODERATOR_CHANNELS=

# Создай приложение на https://dev.twitch.tv/console/apps
# Секреты держи только на сервере — не добавляй их в public/index.html.
TWITCH_CLIENT_ID=вставь_client_id
TWITCH_CLIENT_SECRET=вставь_client_secret
PORT=3000

# Wall moderation: generate a different random token (at least 24 characters) for each moderator.
# Comma-separated list; keep these secrets only in Render Environment, never in public files.
WALL_MODERATOR_TOKENS=replace_with_long_random_token_one,replace_with_long_random_token_two

# On Render, mount a persistent disk at /var/data and set DATA_DIR=/var/data.
# Without a persistent disk, wall submissions may be lost when the service restarts or redeploys.
DATA_DIR=/var/data
